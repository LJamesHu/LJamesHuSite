source "https://rubygems.org"

# This site is built by GitHub Pages' native Jekyll processing. The github-pages
# gem pins Jekyll and all plugins to the exact versions GitHub runs, so a local
# `bundle exec jekyll serve` previews exactly what GitHub will publish.
#
#     bundle install
#     bundle exec jekyll serve
#
gem "github-pages", group: :jekyll_plugins

# Windows-only: file-watching support for `jekyll serve`.
gem "wdm", ">= 0.1.0" if Gem.win_platform?
